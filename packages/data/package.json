{
  "name": "@coderyo/data",
  "version": "1.1.2",
  "description": "TradView protocol types, interval registry, and mock gateway",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js"
    }
  },
  "files": [
    "dist",
    "proto/**"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@coderyo/eslint-config": "workspace:*",
    "@coderyo/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeRyoStudio/tradview.git",
    "directory": "packages/data"
  },
  "publishConfig": {
    "access": "public"
  }
}
