    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@tradview/eslint-config": "workspace:*",
    "@tradview/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}