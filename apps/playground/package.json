{
  "name": "@coderyo/playground",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @coderyo/bridge build && pnpm --filter @coderyo/core build && pnpm --filter @coderyo/data build && pnpm --filter @coderyo/ui-shell build && pnpm --filter @coderyo/renderer-lite build",
    "dev": "node ../../scripts/playground-dev.mjs",
    "dev:vite-only": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coderyo/bridge": "workspace:*",
    "@coderyo/core": "workspace:*",
    "@coderyo/drawings": "workspace:*",
    "@coderyo/data": "workspace:*",
    "@coderyo/indicators": "workspace:*",
    "@coderyo/interaction": "workspace:*",
    "@coderyo/i18n": "workspace:*",
    "@coderyo/ui-shell": "workspace:*",
    "@coderyo/renderer-webgl": "workspace:*",
    "lightweight-charts": "^5.0.7"
  },
  "devDependencies": {
    "@coderyo/tsconfig": "workspace:*",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}