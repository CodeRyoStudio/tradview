{
  "name": "tradview",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "TradingView-style embeddable K-line chart framework",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:mock": "pnpm --filter @tradview/cli-dev dev:mock",
    "dev:playground": "pnpm --filter @tradview/playground dev",
    "demo": "node scripts/demo.mjs --mode=dev",
    "demo:build": "pnpm build && pnpm --filter @tradview/playground build",
    "demo:serve": "node scripts/demo.mjs --mode=preview",
    "build:cdn": "pnpm --filter @tradview/cdn-bundle build",
    "check:cdn-size": "node scripts/check-cdn-size.mjs",
    "version:sync": "node scripts/sync-versions.mjs",
    "check:rc": "node scripts/check-rc.mjs",
    "publish:rc": "pnpm check:rc && pnpm -r publish --access public --tag rc --no-git-checks"
  },
  "devDependencies": {
    "@tradview/eslint-config": "workspace:*",
    "@tradview/tsconfig": "workspace:*",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}